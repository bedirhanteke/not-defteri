{
    "app-id": "com.example.Notes",
    "runtime": "org.gnome.Platform",
    "runtime-version": "46",
    "sdk": "org.gnome.Sdk",
    "command": "run.py",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "modules": [
        {
            "name": "python3-markdown",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app markdown"
            ]
        },
        {
            "name": "notes",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/bin /app/share/applications /app/share/icons/hicolor/scalable/apps",
                "cp -r app run.py /app/bin/",
                "chmod +x /app/bin/run.py",
                "cp data/com.example.Notes.desktop /app/share/applications/",
                "cp data/com.example.Notes.svg /app/share/icons/hicolor/scalable/apps/"
            ]
        }
    ]
}
